#!/bin/sh
# GL-E750V2 (Quectel EM060K-GL): настройки lpac (сборка fildunsky) и вкладки eSIM в 5gmodem

uci -q batch <<'UCI'
set lpac.global=global
set lpac.global.apdu_backend='at_csim'
set lpac.global.http_backend='stdio'
set lpac.global.apdu_debug='0'
set lpac.global.http_debug='0'
set lpac.global.custom_isd_r_aid='A0000005591010FFFFFFFF8900000100'
set lpac.at=at
set lpac.at.device='/dev/ttyUSB2'
set lpac.at.debug='0'
set lpac.qmi=qmi
set lpac.qmi.device='/dev/cdc-wdm0'
set lpac.qmi.uim_slot='1'
set lpac.uqmi=uqmi
set lpac.uqmi.device='/dev/cdc-wdm0'
set lpac.uqmi.uim_slot='1'
commit lpac
UCI

if [ -f /etc/config/5gmodem ]; then
	uci -q get 5gmodem.@5gmodem[0] >/dev/null || uci -q add 5gmodem 5gmodem >/dev/null
	uci -q set 5gmodem.@5gmodem[0].esim_apdu='at'
	uci -q set 5gmodem.@5gmodem[0].esim_http='auto'
	# EM060K-GL (2c7c:030b) нет в списке esimcaps.sh - показываем вкладку eSIM принудительно
	uci -q set 5gmodem.m_1_1_2=modem
	uci -q set 5gmodem.m_1_1_2.path='1-1.2'
	uci -q set 5gmodem.m_1_1_2.esim_show='1'
	uci -q commit 5gmodem
fi

rm -f /etc/config/epm
exit 0
